# Autonomous AI SEO Platform - Environment Configuration Template

# General Environment
ENVIRONMENT=development
DEBUG=true
APP_SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & Vector Store
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/autonomous_seo_db
DATABASE_SYNC_URL=postgresql://postgres:postgrespassword@localhost:5432/autonomous_seo_db

# Redis & Worker Queue
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO Object Storage
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=seo-crawl-snapshots
S3_USE_SSL=false

# LLM Providers
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-pro
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Google Search Console OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Chrome User Experience Report (CrUX)
CRUX_API_KEY=

# Application URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
